@echo off
chcp 65001 > nul
:: ==============================================================================
::   Статистика групп ВК — Локальный PHP Сервер для Windows
::   ВНИМАНИЕ: Батник нужен ТОЛЬКО для запуска на локальном ПК (localhost).
::   На веб-хостинге запускать его НЕ НУЖНО.
:: ==============================================================================
title Статистика групп ВК — Локальный PHP Сервер

echo ==================================================================
echo 🚀 Запуск PHP сервера: Статистика групп ВК
echo    Разработка: Амброзиев О.А.
echo ==================================================================

where php >nul 2>nul
if %ERRORLEVEL% neq 0 (
    echo ❌ Ошибка: PHP не найден в переменной PATH.
    echo Пожалуйста, установите PHP или добавьте его в переменную PATH.
    pause
    exit /b 1
)

start "" http://localhost:8000
php -S 0.0.0.0:8000
