  "meta": {
    "system": "OPAC-Global (DIT-M)",
    "host": "https://opac.lib33.ru",
    "direct_endpoint": "/cgiopac/opacg/direct.exe",
    "login_endpoint": "/cgiopac/opacg/opac.exe",
    "db_id": "62",
    "db_title": "Электронный каталог ЦГБ г. Владимира",
    "default_user": "SHARE",
    "default_pass": "TLBYSQ028",
    "auth_type": "PayAccess"
  },
  "services": {
    "opacfindd.FindView": {
      "version": "2.7.0",
      "method": "POST",
      "description": "Поиск и постраничная выдача библиографических записей",
      "parameters": {
        "_service": "opacfindd.FindView",
        "_version": "2.7.0",
        "userId": "SHARE",
        "session": "{numsean}",
        "iddb": "62",
        "length": "10",
        "start": "0",
        "query/body": "TI {search_query}",
        "query/mode": "wordset",
        "outformList[0]/outform": "SHOTFORM",
        "outformList[1]/outform": "LINEORD"
      },
      "supported_outforms": ["SHOTFORM", "UNIMARC", "BIBCARD", "ORDERFORM"]
    },
    "opacholdd.MoveCopies": {
      "version": "1.0.0",
      "method": "POST",
      "description": "Получение экземпляров (холдингов), инвентарных номеров, статусов доступности и полей 899",
      "parameters": {
        "_service": "opacholdd.MoveCopies",
        "_version": "1.0.0",
        "idbr": "{record_id}",
        "id": "SHARE",
        "session": "{numsean}",
        "userId": "SHARE",
        "iddb": "62"
      }
    },
    "opacfindd.FindSize": {
      "version": "1.1.0",
      "method": "POST",
      "description": "Запрос объема базы данных и количества совпадений",
      "parameters": {
        "_service": "opacfindd.FindSize",
        "_version": "1.1.0",
        "iddb": "62",
        "userId": "SHARE",
        "session": "{numsean}",
        "query": "{query_string}"
      }
    }
  },
  "marc_structure": {
    "title_fields": {
      "tag": "200",
      "subfields": {
        "a": "Основное заглавие",
        "e": "Сведения, относящиеся к заглавию (подзаголовок)",
        "f": "Первые сведения об ответственности (основной автор)",
        "g": "Последующие сведения об ответственности (соавторы, переводчики)",
        "v": "Обозначение тома/выпуска"
      }
    },
    "author_fields": {
      "tag": "700",
      "subfields": {
        "a": "Фамилия автора",
        "b": "Инициалы",
        "g": "Полное имя и отчество",
        "4": "Код роли (070 - автор)"
      },
      "secondary_tags": {
        "701": "Соавторы (индивидуальные)",
        "702": "Вторичные лица (редакторы, составители, художники)",
        "710": "Коллективный автор"
      }
    },
    "publication_fields": {
      "tag": "210",
      "subfields": {
        "a": "Место издания (город)",
        "c": "Наименование издательства",
        "d": "Год издания"
      }
    },
    "classification_fields": {
      "tag": "686",
      "subfields": {
        "a": "Классификационный индекс (ББК)",
        "2": "Код классификационной системы (rubbk)"
      }
    },
    "holding_fields": {
      "tag": "899",
      "subfields": {
        "a": "Организация-фондодержатель ('ЦГБ Г. ВЛАДИМИРА')",
        "b": "Библиотечная сигла филиала/отделения",
        "h": "Основной класс ББК/раздел",
        "i": "Авторский знак (хавкина)",
        "j": "Полный шифр хранения",
        "p": "Штрихкод / RFID-метка ('NO' при отсутствии)",
        "x": "Инвентарный номер экземпляра",
        "y": "Номер и год сопроводительного акта",
        "9": "Балансовая стоимость (цена книги в рублях)"
      }
    }
  },
